<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zhengshuyun</groupId>
    <artifactId>lava-bom</artifactId>
    <version>2.0.0-beta.4</version>
    <packaging>pom</packaging>

    <name>lava-bom</name>
    <description>Lava 模块版本清单</description>
    <url>https://github.com/zhengshuyuncom/lava</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Toint</name>
            <email>599818663@qq.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/zhengshuyuncom/lava.git</connection>
        <developerConnection>scm:git:git@github.com:zhengshuyuncom/lava.git</developerConnection>
        <url>https://github.com/zhengshuyuncom/lava</url>
    </scm>

    <properties>
        <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
        <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 核心工具：ID、重试、流与时间处理。 -->
            <dependency>
                <groupId>com.zhengshuyun</groupId>
                <artifactId>lava-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- JSON 编解码。 -->
            <dependency>
                <groupId>com.zhengshuyun</groupId>
                <artifactId>lava-json</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- HTTP 客户端与 SSE。 -->
            <dependency>
                <groupId>com.zhengshuyun</groupId>
                <artifactId>lava-http</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 微信支付 API v3 协议适配。 -->
            <dependency>
                <groupId>com.zhengshuyun</groupId>
                <artifactId>lava-pay-wechat</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 支付宝开放平台支付协议适配。 -->
            <dependency>
                <groupId>com.zhengshuyun</groupId>
                <artifactId>lava-pay-alipay</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 进程内定时调度。 -->
            <dependency>
                <groupId>com.zhengshuyun</groupId>
                <artifactId>lava-schedule</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 通用密码学基础能力。 -->
            <dependency>
                <groupId>com.zhengshuyun</groupId>
                <artifactId>lava-crypto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- SMTP、IMAP 与 OAuth2 邮件能力。 -->
            <dependency>
                <groupId>com.zhengshuyun</groupId>
                <artifactId>lava-mail</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 简道云开放平台 API 适配。 -->
            <dependency>
                <groupId>com.zhengshuyun</groupId>
                <artifactId>lava-jiandaoyun</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 钉钉开放平台 API 适配。 -->
            <dependency>
                <groupId>com.zhengshuyun</groupId>
                <artifactId>lava-dingtalk</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 独立 BOM 不继承父 POM，需要单独接入 Central 发布生命周期。 -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central-publishing-maven-plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>
            <!-- Maven Central 要求为 BOM 的 POM 构件提供签名。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>${maven-gpg-plugin.version}</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
